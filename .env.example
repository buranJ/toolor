# Server-only secrets. Put values in .env.local (ignored by Git) or hosting.
# Never use NEXT_PUBLIC_ for these variables.
TELEGRAM_BOT_TOKEN=
ADMIN_PASSWORD=
# Set to netlify only for the production Functions context on Netlify.
CATALOG_STORAGE_DRIVER=
TELEGRAM_CHAT_ID=
# Optional numeric forum-topic ID in a supergroup.
TELEGRAM_MESSAGE_THREAD_ID=
# Primary operator's numeric Telegram user ID (same as notification chat ID).
TELEGRAM_OPERATOR_ID=
# Optional explicit CSV allowlist. Include the primary operator; private chats only.
TELEGRAM_OPERATOR_IDS=
# Random 32–256 character webhook secret; never use the bot token here.
TELEGRAM_WEBHOOK_SECRET=
# Leave empty for legacy mode. Durable history: netlify or sqlite (self-hosted).
ORDER_STORAGE_DRIVER=
# Separate namespace per environment. Never expose this store through public APIs.
ORDER_STORAGE_NAMESPACE=
# Self-hosted only: absolute path OUTSIDE the checkout/public directory, on local disk.
ORDER_SQLITE_PATH=
# 1 temporarily pauses checkout and bot changes for the final migration snapshot.
ORDER_MAINTENANCE=0
